# Copy to .env and change for anything beyond a local demo. docker compose reads .env automatically.

# Store. Docker compose builds this from the POSTGRES_* values below; set it yourself only when
# running outside compose. Local default (no variable): sqlite:///var/ti.db
# TI_DATABASE_URL=postgresql+psycopg://stride:stride@localhost:5432/stride

# Signs login tokens. Use a long random value when hosted:  python -c "import secrets; print(secrets.token_urlsafe(48))"
TI_SECRET=local-docker-demo-secret-change-me-0123456789

# Where uploaded workbooks are kept (a named volume in compose).
TI_UPLOADS=/data/uploads

# Extra origins allowed to call the API, comma separated. Empty when the API serves the app itself.
# For `npm run dev` against a local API use http://localhost:5173
TI_CORS=

# Postgres container (compose only)
POSTGRES_USER=stride
POSTGRES_PASSWORD=stride
POSTGRES_DB=stride

# Host port for the app
PORT=8000
